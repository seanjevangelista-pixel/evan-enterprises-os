{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/integrations.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/integrations?action=outreach-cron", "schedule": "0 14 * * *" }
  ],
  "redirects": [
    {
      "source": "/legacy-hardscape",
      "has": [{ "type": "host", "value": "evanenterprise.com" }],
      "destination": "https://legacyhardscapeatx.com/",
      "permanent": true
    },
    {
      "source": "/legacy-hardscape/:path*",
      "has": [{ "type": "host", "value": "evanenterprise.com" }],
      "destination": "https://legacyhardscapeatx.com/:path*",
      "permanent": true
    },
    {
      "source": "/studio27",
      "has": [{ "type": "host", "value": "evanenterprise.com" }],
      "destination": "https://studio27atx.com/",
      "permanent": true
    },
    {
      "source": "/studio27/:path*",
      "has": [{ "type": "host", "value": "evanenterprise.com" }],
      "destination": "https://studio27atx.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/portal",
      "destination": "/portal/index.html"
    },
    {
      "source": "/leads",
      "destination": "/leads/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/studio27",
      "destination": "/studio27/index.html"
    },
    {
      "source": "/studio27/about",
      "destination": "/studio27/about/index.html"
    },
    {
      "source": "/studio27/services",
      "destination": "/studio27/services/index.html"
    },
    {
      "source": "/studio27/portfolio",
      "destination": "/studio27/portfolio/index.html"
    },
    {
      "source": "/studio27/photo-booth",
      "destination": "/studio27/photo-booth/index.html"
    },
    {
      "source": "/studio27/contact",
      "destination": "/studio27/contact/index.html"
    },
    {
      "source": "/legacy-hardscape",
      "destination": "/legacy-hardscape/index.html"
    },
    {
      "source": "/legacy-hardscape/about",
      "destination": "/legacy-hardscape/about/index.html"
    },
    {
      "source": "/legacy-hardscape/contact",
      "destination": "/legacy-hardscape/contact/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "legacyhardscapeatx.com" }],
      "destination": "/legacy-hardscape/index.html"
    },
    {
      "source": "/about",
      "has": [{ "type": "host", "value": "legacyhardscapeatx.com" }],
      "destination": "/legacy-hardscape/about/index.html"
    },
    {
      "source": "/contact",
      "has": [{ "type": "host", "value": "legacyhardscapeatx.com" }],
      "destination": "/legacy-hardscape/contact/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}